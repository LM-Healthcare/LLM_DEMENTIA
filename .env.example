# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Embedding multilingue: le cartelle cliniche sono in italiano, la knowledge
# base in inglese. Cambiarlo richiede una reindicizzazione completa.
OLLAMA_EMBED_MODEL=bge-m3

# Knowledge base e vector store
CHROMA_DB_PATH=./chroma_db
DOCS_FOLDER=./Documenti_
RAG_DEFAULT_MODE=budson

# Database clinico
DATABASE_PATH=./Database_FINALE_codificato.xlsx
REFERENCE_VALUES_PATH=./Valori di riferimento_lab.xlsx

# Chunking (in caratteri). Modificarli richiede una reindicizzazione.
RAG_PARENT_CHUNK_SIZE=2000
RAG_PARENT_CHUNK_OVERLAP=250
RAG_CHILD_CHUNK_SIZE=450
RAG_CHILD_CHUNK_OVERLAP=60
# Lunghezza minima di un passaggio citabile: sotto questa soglia viene fuso con
# il vicino, così un titolo di sezione non diventa una "fonte" priva di contenuto.
RAG_MIN_CHUNK_CHARS=350

# Retrieval
RAG_TOP_K=8
RAG_CANDIDATES_PER_QUERY=10
RAG_BM25_WEIGHT=0.4
RAG_RRF_K=60
RAG_CLINICAL_QUERY_WEIGHT=20
RAG_MAX_PER_PAGE=2
RAG_MAX_PER_SOURCE=5
# Step in cui iniettare il contesto RAG (lista separata da virgole)
RAG_STEPS=1

# Generazione
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_NUM_CTX=12288
LLM_TIMEOUT_S=600
LLM_RETRIES_ON_INVALID=0
